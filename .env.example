# Plantilla de configuración. Copiar a .env y rellenar secretos.
# El .env real está gitignored. NO poner secretos reales en este archivo:
# .env.example SÍ se versiona.

SERVICE_NAME=project-management-service
SERVICE_VERSION=0.1.0
ENV=dev

HTTP_ADDR=:8084
# host.docker.internal: el contenedor Consul debe alcanzar el /health del
# servicio en el host. 127.0.0.1 apuntaría al propio contenedor → el check
# falla, queda critical y el servicio se desregistra tras DeregisterCriticalServiceAfter.
ADVERTISE_HOST=host.docker.internal
HEALTH_PATH=/health

# --- Runtime DB (usuario de mínimos privilegios: SELECT/INSERT/UPDATE) ---
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=svc_project_mgmt
DB_PASS=__SET_ME__
DB_NAME=project_management
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25

# --- Migration DB (root, DDL). Solo se usa al startup para `goose up`. ---
# goose = fuente de verdad del schema; el infra solo crea DB + usuario.
DB_ROOT_USER=root
DB_ROOT_PASS=__SET_ME__

# --- Consul (fail-fast=false: la app arranca aunque Consul esté caído) ---
CONSUL_ENABLED=true
CONSUL_HOST=localhost
CONSUL_PORT=8500
CONSUL_TOKEN=
CONSUL_HEALTH_INTERVAL=10s
